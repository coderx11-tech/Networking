    def setup_directories(self):
        """Create Kali tools directory structure"""
        directories = [self.kali_dir, self.bin_dir, self.config_dir, self.kali_dir / "wordlists", self.kali_dir / "output"]
        for directory in directories:
            directory.mkdir(parents=True, exist_ok=True)
        print(f"📁 Kali tools directory: {self.kali_dir}")

    def run_command(self, command, shell=False):
        """Run system command with error handling"""
        try:
            if shell:
                result = subprocess.run(command, shell=True, capture_output=True, text=True, check=True)
            else:
                result = subprocess.run(command, capture_output=True, text=True, check=True)
            return True, result.stdout
        except subprocess.CalledProcessError as e:
            return False, e.stderr

    def check_termux(self):
        """Verify we're running in Termux"""
        if not Path(self.termux_prefix).exists():
            print("❌ This script must be run in Termux!")
            print("📥 Install Termux from F-Droid: https://f-droid.org/en/packages/com.termux/")
            return False
        return True

    def setup_kali_repos(self):
        """Add Kali Linux repositories to Termux"""
        print("🔧 Setting up Kali Linux repositories...")
        
        # Create sources.list.d directory if it doesn't exist
        sources_dir = Path(self.termux_prefix) / "etc" / "apt" / "sources.list.d"
        sources_dir.mkdir(parents=True, exist_ok=True)
        
        # Add Kali repository
        kali_sources = sources_dir / "kali.list"
        with open(kali_sources, 'w') as f:
            f.write("deb https://http.kali.org/kali kali-rolling main contrib non-free\n")
        
        # Download and add Kali repository key
        key_url = "https://archive.kali.org/archive-key.asc"
        key_path = Path("/tmp/kali-key.asc")
        
        try:
            urllib.request.urlretrieve(key_url, key_path)
            success, output = self.run_command(["apt-key", "add", str(key_path)])
            if success:
                print("✅ Kali repository key added")
            else:
                print("❌ Failed to add Kali repository key")
        except Exception as e:
            print(f"❌ Failed to download Kali key: {e}")
        
        # Update package lists
        print("🔄 Updating package lists with Kali repositories...")
        success, output = self.run_command(["pkg", "update"])
        if success:
            print("✅ Kali repositories configured successfully")
            return True
        else:
            print("❌ Failed to update package lists")
            return False

    def install_via_pkg(self, package_name):
        """Install package via pkg (Termux)"""
        try:
            print(f"📦 Installing {package_name}...")
            subprocess.run(["pkg", "install", "-y", package_name], check=True)
            
            # Verify installation
            if shutil.which(package_name) or self.is_package_installed(package_name):
                print(f"✅ {package_name} installed successfully")
                return True
            else:
                print(f"⚠️ {package_name} installed but not in PATH")
                return True
                
        except subprocess.CalledProcessError:
            print(f"❌ Failed to install {package_name} via pkg")
            return False

    def install_via_pip(self, package_name):
        """Install Python package via pip"""
        try:
            print(f"🐍 Installing {package_name} via pip...")
            subprocess.run(["pip", "install", "--user", package_name], check=True)
            print(f"✅ {package_name} installed via pip")
            return True
        except subprocess.CalledProcessError:
            print(f"❌ Failed to install {package_name} via pip")
            return False

    def is_package_installed(self, package_name):
        """Check if package is installed"""
        try:
            subprocess.run(["dpkg", "-s", package_name], capture_output=True, check=True)
            return True
        except subprocess.CalledProcessError:
            return False

