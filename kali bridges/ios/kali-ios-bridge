        else:
            # Generic environment
            commands = [
                "python3 -m ensurepip",
                "pip3 install --upgrade pip"
            ]
        
        for cmd in commands:
            success, output = self.run_command(cmd)
            if success:
                print(f"✅ {cmd}")
            else:
                print(f"⚠️ Failed: {cmd}")
        
        return True

    def download_file(self, url, destination):
        """Download file from URL"""
        try:
            print(f"📥 Downloading {url}...")
            urllib.request.urlretrieve(url, destination)
            return True
        except Exception as e:
            print(f"❌ Download failed: {e}")
            return False

    def extract_archive(self, archive_path, extract_to):
        """Extract various archive formats"""
        try:
            if archive_path.suffix in ['.gz', '.bz2', '.xz']:
                # Tar archive
                with tarfile.open(archive_path, 'r:*') as tar:
                    tar.extractall(extract_to)
            elif archive_path.suffix == '.zip':
                # Zip archive
                with zipfile.ZipFile(archive_path, 'r') as zip_ref:
                    zip_ref.extractall(extract_to)
            else:
                print(f"❌ Unsupported archive format: {archive_path.suffix}")
                return False
            return True
        except Exception as e:
            print(f"❌ Extraction failed: {e}")
            return False

    def install_via_pip(self, package_name):
        """Install Python package via pip"""
        try:
            print(f"🐍 Installing {package_name} via pip...")
            subprocess.run([sys.executable, "-m", "pip", "install", package_name], check=True)
            print(f"✅ {package_name} installed via pip")
            return True
        except subprocess.CalledProcessError:
            print(f"❌ Failed to install {package_name} via pip")
            return False

    def compile_from_source(self, tool_name, tool_info):
        """Compile and install tool from source"""
        print(f"🔨 Compiling {tool_name} from source...")
        
        # Download source
        download_path = self.temp_dir / f"{tool_name}_source"
        if not self.download_file(tool_info['url'], download_path):
            return False
        
        # Extract source
        extract_dir = self.src_dir / tool_name
        extract_dir.mkdir(exist_ok=True)
        
        if not self.extract_archive(download_path, extract_dir):
            return False
        
        # Find the actual source directory
        source_dir = None
        for item in extract_dir.iterdir():
            if item.is_dir():
                source_dir = item
                break
        
        if not source_dir:
            print("❌ Could not find source directory")
            return False
        
        # Build and install
        os.chdir(source_dir)
        
        try:
            # Run build commands
            build_cmd = tool_info.get('build_cmd', './configure && make && make install')
            for cmd in build_cmd.split('&&'):
                cmd = cmd.strip()
                success, output = self.run_command(cmd)
                if not success:
                    print(f"❌ Build failed at: {cmd}")
                    return False
            
            print(f"✅ {tool_name} compiled and installed successfully")
            return True
            
        except Exception as e:
            print(f"❌ Compilation failed: {e}")
            return False
        finally:
            os.chdir(self.home_dir)

