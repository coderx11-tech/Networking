    def detect_ios_environment(self):
        """Detect which iOS environment we're running in"""
        env_indicators = {
            'iSH': ['/etc/alpine-release', '/bin/busybox'],
            'a-Shell': ['/usr/bin/ash', '/usr/bin/fileproviderctl'],
            'Blink': ['/usr/bin/blink', '/var/mobile/blink'],
            'Pythonista': ['/var/mobile/Containers/Shared/AppGroup'],
            'StaSh': ['/var/mobile/stash']
        }
        
        for env_name, paths in env_indicators.items():
            for path in paths:
                if Path(path).exists():
                    print(f"📱 Detected environment: {env_name}")
                    return env_name
        
        print("📱 Unknown iOS environment - using generic setup")
        return "Generic"

    def setup_directories(self):
