    def add_to_path(self):
        """Add kali-tools/bin to PATH"""
        shell_rc_files = [
            self.home_dir / ".bashrc",
            self.home_dir / ".zshrc",
            self.home_dir / ".profile"
        ]
        
        path_line = f'\nexport PATH="$HOME/kali-tools/bin:$PATH"\n'
        
        for rc_file in shell_rc_files:
            if rc_file.exists():
                with open(rc_file, 'a') as f:
                    f.write(path_line)
                print(f"✅ Added to {rc_file}")
        
        # Add to current session
        os.environ["PATH"] = f"{self.bin_dir}:{os.environ['PATH']}"

