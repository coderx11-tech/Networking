    def check_admin(self):
        """Check if running as administrator"""
        try:
            return ctypes.windll.shell32.IsUserAnAdmin()
        except:
            return False

    def setup_directories(self):
        """Create Kali tools directory structure"""
        directories = [self.kali_dir, self.bin_dir, self.tools_dir, self.kali_dir / "logs"]
        for directory in directories:
            directory.mkdir(parents=True, exist_ok=True)
        print(f"📁 Kali tools directory: {self.kali_dir}")

    def run_command(self, command, shell=True, check=True):
        """Run system command with error handling"""
        try:
            result = subprocess.run(command, shell=shell, capture_output=True, text=True, check=check)
            return True, result.stdout
        except subprocess.CalledProcessError as e:
            return False, e.stderr

    def add_to_path(self, directory):
        """Add directory to system PATH"""
        try:
            # Current user PATH
            with winreg.OpenKey(winreg.HKEY_CURRENT_USER, "Environment", 0, winreg.KEY_READ) as key:
                try:
                    current_path = winreg.QueryValueEx(key, "PATH")[0]
                except FileNotFoundError:
                    current_path = ""

            if str(directory) not in current_path:
                new_path = f"{current_path};{directory}" if current_path else str(directory)
                
                with winreg.OpenKey(winreg.HKEY_CURRENT_USER, "Environment", 0, winreg.KEY_SET_VALUE) as key:
                    winreg.SetValueEx(key, "PATH", 0, winreg.REG_EXPAND_SZ, new_path)
                
                print(f"✅ Added {directory} to PATH")
                return True
        except Exception as e:
            print(f"❌ Failed to add to PATH: {e}")
        return False

    def install_chocolatey(self):
        """Install Chocolatey package manager"""
        if not shutil.which("choco"):
            print("🍫 Installing Chocolatey...")
            command = 'Set-ExecutionPolicy Bypass -Scope Process -Force; [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; iex ((New-Object System.Net.WebClient).DownloadString("https://community.chocolatey.org/install.ps1"))'
            success, output = self.run_command(command)
            if success:
                print("✅ Chocolatey installed successfully")
                return True
            else:
                print("❌ Failed to install Chocolatey")
                return False
        return True

    def install_wsl_kali(self):
        """Install WSL2 with Kali Linux"""
        if not self.is_admin:
            print("❌ Administrator rights required for WSL installation")
            return False

        print("🐧 Installing WSL2 with Kali Linux...")
        
        # Enable WSL feature
        commands = [
            'dism.exe /online /enable-feature /featurename:Microsoft-Windows-Subsystem-Linux /all /norestart',
            'dism.exe /online /enable-feature /featurename:VirtualMachinePlatform /all /norestart'
        ]
        
        for cmd in commands:
            success, output = self.run_command(cmd)
            if not success:
                print(f"❌ Failed to enable WSL: {cmd}")
                return False
        
        # Download and set WSL2 as default
        wsl_update_url = "https://wslstorestorage.blob.core.windows.net/wslblob/wsl_update_x64.msi"
        wsl_update_path = self.tools_dir / "wsl_update.msi"
        
        print("📥 Downloading WSL2 kernel update...")
        urllib.request.urlretrieve(wsl_update_url, wsl_update_path)
        self.run_command(f'msiexec /i "{wsl_update_path}" /quiet')
        
        # Set WSL2 as default
        self.run_command('wsl --set-default-version 2')
        
        # Install Kali Linux
        print("📥 Installing Kali Linux...")
        success, output = self.run_command('wsl --install -d kali-linux')
        if success:
            print("✅ Kali Linux installed in WSL2")
            return True
        else:
            print("❌ Failed to install Kali Linux")
            return False

    def download_file(self, url, destination):
        """Download file from URL"""
        try:
            print(f"📥 Downloading {url}...")
            urllib.request.urlretrieve(url, destination)
            return True
        except Exception as e:
            print(f"❌ Download failed: {e}")
            return False

    def extract_zip(self, zip_path, extract_to):
        """Extract ZIP file"""
        try:
            with zipfile.ZipFile(zip_path, 'r') as zip_ref:
                zip_ref.extractall(extract_to)
            return True
        except Exception as e:
            print(f"❌ Extraction failed: {e}")
            return False

    def install_via_chocolatey(self, package_name):
        """Install package via Chocolatey"""
        try:
            print(f"🍫 Installing {package_name} via Chocolatey...")
            subprocess.run(["choco", "install", package_name, "-y", "--force"], check=True)
            return True
        except subprocess.CalledProcessError:
            return False

    def install_via_pip(self, package_name):
        """Install Python package via pip"""
        try:
            print(f"🐍 Installing {package_name} via pip...")
            subprocess.run([sys.executable, "-m", "pip", "install", package_name], check=True)
            return True
        except subprocess.CalledProcessError:
            return False

    def run_installer(self, installer_path, silent=True):
        """Run Windows installer"""
        try:
            print(f"⚙️ Running installer: {installer_path}")
            if silent:
                subprocess.run([installer_path, "/S", "/quiet", "/norestart"], check=True)
            else:
                subprocess.run([installer_path], check=True)
            return True
        except subprocess.CalledProcessError:
            return False

    def install_native_tool(self, tool_name, tool_info):
        """Install native Windows version of tool"""
        if 'native_url' not in tool_info:
            print(f"❌ No native download URL for {tool_name}")
            return False
        
        print(f"🖥️ Installing native Windows version of {tool_name}...")
        
        # Download the tool
        download_path = self.tools_dir / f"{tool_name}_setup"
        if not self.download_file(tool_info['native_url'], download_path):
            return False
        
        # Handle different file types
        if download_path.suffix.lower() in ['.exe', '.msi']:
            return self.run_installer(download_path)
        elif download_path.suffix.lower() in ['.zip', '.7z']:
            return self.handle_zip_installation(tool_name, download_path, tool_info)
        else:
            print(f"❌ Unsupported file type: {download_path.suffix}")
            return False

    def handle_zip_installation(self, tool_name, zip_path, tool_info):
        """Handle ZIP file installation"""
        tool_dir = self.tools_dir / tool_name
        tool_dir.mkdir(exist_ok=True)
        
        if not self.extract_zip(zip_path, tool_dir):
            return False
        
        # Look for executables and create batch wrappers
        for file_path in tool_dir.rglob('*.exe'):
            if file_path.is_file():
                # Create batch wrapper
                wrapper_content = f'@echo off\n"{file_path}" %*\n'
                wrapper_file = self.bin_dir / f"{tool_name}.bat"
                with open(wrapper_file, 'w') as f:
                    f.write(wrapper_content)
                print(f"✅ {tool_name} installed to {tool_dir}")
                return True
        
        print(f"❌ No executable found for {tool_name}")
        return False

    def install_via_wsl(self, tool_name):
        """Install tool via WSL Kali Linux"""
        if not shutil.which("wsl"):
            print("❌ WSL not installed")
            return False
        
        print(f"🐧 Installing {tool_name} via WSL Kali Linux...")
        command = f'wsl -d kali-linux -u root apt update && wsl -d kali-linux -u root apt install -y {tool_name}'
        success, output = self.run_command(command)
        
        if success:
            # Create Windows batch wrapper
            wrapper_content = f'@echo off\nwsl -d kali-linux {tool_name} %*\n'
            wrapper_file = self.bin_dir / f"{tool_name}.bat"
            with open(wrapper_file, 'w') as f:
                f.write(wrapper_content)
            print(f"✅ {tool_name} installed via WSL")
            return True
        else:
            print(f"❌ Failed to install {tool_name} via WSL")
            return False

    def install_tool(self, tool_name):
        """Install a specific Kali tool using best available method"""
        if tool_name not in self.genuine_kali_tools:
            print(f"❌ Tool {tool_name} not found")
            return False
        
        tool_info = self.genuine_kali_tools[tool_name]
        print(f"\n🚀 Installing {tool_name}: {tool_info['description']}")
        
        # Try installation methods in order of preference
        methods = tool_info['methods']
        
        for method in methods:
            if method == 'native' and 'native_url' in tool_info:
                if self.install_native_tool(tool_name, tool_info):
                    return True
            elif method == 'choco' and 'choco' in tool_info:
                if self.install_via_chocolatey(tool_info['choco']):
                    return True
            elif method == 'python' and 'pip' in tool_info:
                if self.install_via_pip(tool_info['pip']):
                    return True
            elif method == 'wsl':
                if self.install_via_wsl(tool_name):
                    return True
        
        print(f"❌ All installation methods failed for {tool_name}")
        return False

